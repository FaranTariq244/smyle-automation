# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/

# Google Sheets credentials
auth.json
credentials.json
token.json

# BigQuery credentials
bigquery_auth.json
bigquery_sa.json

# Environment variables
.env

# Shopify credentials (live admin token — never commit)
shopify.env
shopify-connection.env

# my-fulfilment.com (Nic. Oud) portal login — never commit
fulfilment.env
# Cached portal session cookies — live credentials, same as the password.
# The glob matters: the session pool writes .pool0/.pool1/... alongside it.
fulfilment_session.cookies*

# Slack Incoming Webhook URL — secret, never commit
supervisor/slack.env
# Supervisor rendered-prompt scratch files
supervisor/_prompt_*.txt

# Throwaway debug scripts (e.g. _debug_x.py) — but NOT dunders like __init__.py
_[!_]*.py

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs (and runtime debug/failure screenshots saved alongside them)
*.log
logs/*.png

# Screenshots and reports
screenshots/
reports/

# Project-specific exclusions
notneeded/
nul
chrome_profile/
logsforCodex.txt
tableForXodexToReview.txt
config.db

# Claude Code
.claude/settings.local.json

# JSON report outputs
order_type_report_*.json
